# KodeKshetra Server Environment Variables

# MongoDB Connection
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret Key (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Redis Connection (optional — falls back to redis://localhost:6379)
# Example: redis://localhost:6379 or redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# Server Port (PORT takes precedence over PORT_NO when both are set)
PORT_NO=5000

# Email allowed to reach the admin problem-importer endpoints.
# Set this explicitly: when unset the code falls back to admin@gmail.com, so
# anyone who registers that address gains importer access.
ADMIN_EMAIL=

# Shared secret sent as the x-internal-token header to Code-Runner and
# HiddenForces. Leave blank to disable service-to-service auth (dev only —
# both downstream services then accept requests from anyone).
INTERNAL_SERVICE_TOKEN=

# Cloudinary Configuration (for profile picture uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development

# Optional comma-separated frontend origins for CORS/Socket.IO
# Example: https://kode-kshetra-client.vercel.app,https://your-preview.vercel.app
CORS_ORIGINS=

# Hidden Forces API (Test Case Generator)
HIDDEN_FORCES_URL=http://127.0.0.1:8000

# Code Runner API (Code Execution)
CODE_RUNNER_URL=http://127.0.0.1:9000

# ---- Scalability Tuning (1000+ concurrent users) ----

# MongoDB connection pool (default: 150)
MONGO_MAX_POOL_SIZE=150
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=60000

# Rate limiting — Auth routes (per IP, default: 30 req per 15 min)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30

# Rate limiting — Code execution routes (per IP, default: 60 req per min)
RATE_LIMIT_EXEC_WINDOW_MS=60000
RATE_LIMIT_EXEC_MAX=60

# Rate limiting — General API routes (per IP, default: 300 req per min)
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300

# Socket.IO safety settings
SOCKETIO_MAX_HTTP_BUFFER_SIZE=1000000
SOCKETIO_PING_TIMEOUT_MS=20000
SOCKETIO_PING_INTERVAL_MS=25000

# Redis lock spin-wait hard cap in ms (default: 10000 = 10 seconds)
REDIS_LOCK_SPIN_WAIT_MAX_MS=10000

# Battle length in seconds (default: 1800 = 30 min). Also drives the XP
# "fast finish" bonus, so keep it in sync with what the client counts down.
BATTLE_DURATION_SECONDS=1800

# Outbound HTTP client for Code-Runner (default timeout: 35000, sockets: 512).
# Note: requests are retried 3 times, so worst-case latency is ~4x the timeout.
CODE_RUNNER_TIMEOUT_MS=35000
CODE_RUNNER_MAX_SOCKETS=512

# In-memory problem cache used by the /run and /submit proxies
PROBLEM_CACHE_TTL_MS=300000
PROBLEM_CACHE_MAX_SIZE=1000

# Distributed lock TTLs in ms (defaults: 5000)
MATCHMAKING_LOCK_TTL_MS=5000
USER_UPDATE_LOCK_TTL_MS=5000
PRIVATE_ROOM_LOCK_TTL_MS=5000

# Private room / submission state TTLs in seconds (defaults: 7200 = 2 hours)
PRIVATE_ROOM_TTL_SECONDS=7200
BATTLE_SUBMISSION_TTL_SECONDS=7200

# Battle resolution lock in ms. Defaults to CODE_RUNNER_TIMEOUT_MS * 4 + 20000
# so a slow runner can't let a second caller re-resolve the same battle and
# double-apply XP. Only override if you know the runner's worst-case latency.
BATTLE_PROCESSING_LOCK_TTL_MS=

# Redis pub/sub channel used to fan socket events across server instances
USER_EVENT_CHANNEL=kodekshetra:user-events

# HTTP server timeouts in ms. keep-alive must stay below headers timeout.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=70000
