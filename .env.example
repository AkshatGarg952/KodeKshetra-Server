# KodeKshetra Server Environment Variables

# MongoDB Connection
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret Key (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Redis Connection
# Example: redis://localhost:6379 or redis://username:password@host:port
REDIS_URL=redis://red-d3jqe6ffte5s7380jmpg:6379

# Server Port
PORT_NO=5000

# Cloudinary Configuration (for profile picture uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development

# Hidden Forces API (Test Case Generator)
HIDDEN_FORCES_URL=http://127.0.0.1:8000

# Code Runner API (Code Execution)
CODE_RUNNER_URL=http://127.0.0.1:9000
