# Copy to .env and fill in real values.
# Vite inlines VITE_* variables at BUILD time, so these must be set before
# `npm run build` — changing them later requires a rebuild, not a restart.

# Base URL of KodeKshetra-Server (REST + Socket.IO)
VITE_SERVER_URL=http://localhost:5000

# Email that unlocks the in-app admin problem importer. Must match the
# ADMIN_EMAIL configured on the server, which enforces it server-side.
VITE_ADMIN_EMAIL=
