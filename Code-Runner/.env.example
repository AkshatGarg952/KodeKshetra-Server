PORT=9000
NODE_ENV=development

# Required — startup fails without it.
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions

# Shared secret expected in the x-internal-token header. Must match the value
# set on KodeKshetra-Server. Leave blank to disable the check — the execution
# API is then fully public, and the service logs a warning at startup.
INTERNAL_SERVICE_TOKEN=

# Extra browser origins allowed by CORS (comma-separated).
# localhost:5173 and 127.0.0.1:5173 are always allowed.
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
# Raised from 100 to 3000: with 1000 concurrent users each running code in battles,
# 100 req/min would reject nearly all requests. 3000/min = 50 req/sec globally.
RATE_LIMIT_MAX_REQUESTS=3000

# Request payload guards
MAX_CODE_LENGTH=100000
MAX_CUSTOM_TESTCASES=25

# Execution queue — caps how much work is in flight against Judge0 at once
MAX_CONCURRENT_EXECUTIONS=40
MAX_PENDING_EXECUTIONS=400

# Judge0 client tuning
JUDGE0_TIMEOUT_MS=15000
JUDGE0_MAX_POLL_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_SOCKETS=256
