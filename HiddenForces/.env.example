# Copy to .env and fill in real values.

# Required — the service refuses to start without it.
GOOGLE_API_KEY=your_google_generative_ai_key

# Port uvicorn binds to (default: 8000)
PORT=8000

# Shared secret expected in the x-internal-token header. Must match the value
# set on KodeKshetra-Server. Leave blank to disable the check — every endpoint
# is then reachable by anyone who can route to this service.
INTERNAL_SERVICE_TOKEN=

# Allowed browser origins for CORS (comma-separated).
# Defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
CORS_ORIGINS=
